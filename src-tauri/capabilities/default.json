{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "SNDeck player default capabilities",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-open"
  ]
}
