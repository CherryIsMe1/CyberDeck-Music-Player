{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "Cyberdeck Snake Nation",
  "version": "1.0.0",
  "identifier": "com.snakenation.cyberdeck",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CYBERDECK // SNAKE NATION [NOMAD DECK]",
        "width": 1240,
        "height": 840,
        "minWidth": 850,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#07090E"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Audio",
    "shortDescription": "Cyberpunk Snake Nation Nomad Audio Deck",
    "longDescription": "High-fidelity local MP3 music player & visualizer themed around Cyberpunk Edgerunners Snake Nation Nomad clan."
  }
}
